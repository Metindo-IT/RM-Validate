<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_production_confirm" model="ir.ui.view">
        <field name="name">stock.picking.type.production.confirm</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_location_dest_id']" position="after">
                <field name="use_production_confirm" invisible="code != 'internal'"/>
                <field name="production_location_id" invisible="not use_production_confirm" required="use_production_confirm"/>
                <field name="receive_picking_type_id" invisible="not use_production_confirm" required="use_production_confirm"/>
            </xpath>
        </field>
    </record>
</odoo>
